@echo off
rem Build the single-file engine: C++ source + v16v2.nnue linked into one static .exe.
rem   build_one_exe.cmd                 -> v16v2.7_all.exe  (uses v16v2.nnue)
rem   build_one_exe.cmd mynet.nnue out  -> out.exe          (uses mynet.nnue)
rem Requires the MinGW g++ used for the other v16 builds on PATH.
setlocal
set SRC=v16v2.7_embed.cpp
set NET=%1
set OUT=%2
set MARCH=%3
if "%NET%"=="" set NET=v16v2.nnue
if "%OUT%"=="" set OUT=v16v2.7_all.exe
if "%MARCH%"=="" set MARCH=x86-64-v3

if not exist "%NET%" (
  echo [error] net file not found: %NET%
  exit /b 1
)

rem nnue_embed.S hard-codes the .incbin path, so regenerate it for the chosen net.
> nnue_embed.S echo /* generated by build_one_exe.cmd */
>>nnue_embed.S echo     .section .rdata,"dr"
>>nnue_embed.S echo     .p2align 6
>>nnue_embed.S echo     .globl nnueBlobStart
>>nnue_embed.S echo nnueBlobStart:
>>nnue_embed.S echo     .incbin "%NET%"
>>nnue_embed.S echo     .globl nnueBlobEnd
>>nnue_embed.S echo nnueBlobEnd:
>>nnue_embed.S echo     .p2align 6

g++ -O3 -march=%MARCH% -std=c++17 -static -o "%OUT%" "%SRC%" nnue_embed.S -pthread
if errorlevel 1 exit /b 1
echo built %OUT% ^(net: %NET%^)
endlocal
